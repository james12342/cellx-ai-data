{
  "templateType": "cellx-workflow-designer",
  "version": "1.0",
  "exportedAt": "2026-09-08T00:00:00.000Z",
  "name": "TradingAgents GitHub External Agent Demo",
  "description": "Use a GitHub open-source AI agent repo as an external workflow step. Default mode previews the payload and repo settings before any live execution.",
  "nodes": [
    {
      "id": "node-1",
      "type": "trigger",
      "name": "Schedule",
      "action": "cron",
      "notes": "Run this market analysis workflow manually or on a schedule.",
      "icon": null,
      "x": 90,
      "y": 120,
      "integrationSettings": {
        "owner": "Finance Agent Demo",
        "timeout": "30"
      },
      "connection": null,
      "testResult": null
    },
    {
      "id": "node-2",
      "type": "external-agent",
      "name": "TradingAgents GitHub Agent",
      "action": "/ext-api/external-agent/run",
      "notes": "Clone the TradingAgents GitHub repo, map ticker JSON input, and run an adapter command in a controlled backend runner.",
      "icon": null,
      "x": 330,
      "y": 120,
      "integrationSettings": {
        "agentName": "TradingAgents",
        "runLocation": "customer_local",
        "runnerName": "customer-runner-1",
        "connectionType": "github_repo",
        "repoUrl": "https://github.com/TauricResearch/TradingAgents",
        "branch": "main",
        "installCommand": "pip install -r requirements.txt",
        "runCommand": "python cellx_agent_adapter.py",
        "secretEnvNames": "OPENAI_API_KEY,FINNHUB_API_KEY",
        "refreshRepo": "false",
        "inputMapping": "{\n  \"ticker\": \"NVDA\",\n  \"analysis_date\": \"2026-09-08\",\n  \"risk_level\": \"medium\",\n  \"previous\": {{previous_step}}\n}",
        "outputSchema": "{\n  \"ok\": true,\n  \"agent\": \"TradingAgents\",\n  \"summary\": \"short investment workflow summary\",\n  \"decision\": \"watch\",\n  \"risks\": [],\n  \"rows\": []\n}",
        "executeLive": "false",
        "timeout": "30",
        "retryPolicy": "2 retries, exponential backoff"
      },
      "connection": null,
      "testResult": null
    },
    {
      "id": "node-3",
      "type": "tool",
      "name": "JSON Transform",
      "action": "/ext-api/tools/json-transform",
      "notes": "Normalize the agent output into dashboard, email, or database fields.",
      "icon": null,
      "x": 590,
      "y": 120,
      "integrationSettings": {
        "sourcePath": "previous_step",
        "transformMapping": "summary <- {{summary}}\ndecision <- {{decision}}\nrisks <- {{risks}}\nagent <- {{agent}}\nrepo <- {{repo}}",
        "outputMode": "object"
      },
      "connection": null,
      "testResult": null
    },
    {
      "id": "node-4",
      "type": "log",
      "name": "Write Agent Run Log",
      "action": "cx_workflow_log",
      "notes": "Record the GitHub agent run and output for audit.",
      "icon": null,
      "x": 850,
      "y": 120,
      "integrationSettings": {
        "tableName": "cx_workflow_log",
        "owner": "Finance Agent Demo",
        "timeout": "30"
      },
      "connection": null,
      "testResult": null
    }
  ],
  "links": [
    { "from": "node-1", "to": "node-2" },
    { "from": "node-2", "to": "node-3" },
    { "from": "node-3", "to": "node-4" }
  ]
}
