# Copy this file to .env, then fill in your SMTP settings.
# For Gmail/Outlook, use an app password if normal account password login is blocked.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TO=recipient_email@example.com
SMTP_USE_TLS=true
